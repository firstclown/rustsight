#!/usr/bin/env bash
# Full-stack smoke run: the complete rustsight pipeline — retain →
# consolidate → reflect → judge → report — against REAL providers, on a
# tiny committed fixture (one bank, 12 sessions, 7 questions covering all
# five LongMemEval abilities). Use this to prove the stack front-to-back
# before committing days to the full LongMemEval-S run; see NEXT_STEPS.md
# RS-6 for the postmortem that motivated it.
#
# Usage:
#   scripts/fullstack-smoke                       # real providers + judge
#   RUSTSIGHT_EVAL_FEATURES=rustsight-providers/onnx-rerank-cuda \
#       scripts/fullstack-smoke                    # with the local reranker
#   scripts/fullstack-smoke --mock                 # offline (no keys needed)
#
# Extra args pass through to rustsight-eval (--heartbeat-secs, --mock, ...).
# The output dir (default evals/fullstack-smoke) is rotated to *.prev on
# each run so every invocation is a fresh, repeatable end-to-end pass.
#
# Requires: cargo (on PATH or ~/.cargo/bin). For real runs:
# RUSTSIGHT_LLM_API_KEY plus the three RUSTSIGHT_EVAL_JUDGE_* variables.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

export PATH="$HOME/.cargo/bin:$PATH"

if ! printf '%s\n' "$@" | grep -q -- '--mock'; then
    : "${RUSTSIGHT_LLM_API_KEY:?RUSTSIGHT_LLM_API_KEY must be set (or pass --mock)}"
    for v in RUSTSIGHT_EVAL_JUDGE_BASE_URL RUSTSIGHT_EVAL_JUDGE_API_KEY RUSTSIGHT_EVAL_JUDGE_MODEL; do
        if [ -z "${!v:-}" ]; then
            echo "fullstack-smoke: $v must be set for the real judge (or pass --mock)" >&2
            exit 1
        fi
    done
fi

OUT="${RUSTSIGHT_EVAL_OUT:-evals/fullstack-smoke}"
if [ -e "$OUT" ]; then
    mv "$OUT" "${OUT}.prev"
    echo "fullstack-smoke: rotated previous run to ${OUT}.prev"
fi

FEATURES="${RUSTSIGHT_EVAL_FEATURES:-}"
# shellcheck disable=SC2086
cargo run -p rustsight-eval ${FEATURES:+--features "$FEATURES"} -- \
    --dataset-path crates/rustsight-eval/fixtures/fullstack_smoke.json \
    --out "$OUT" \
    --conversations 1 \
    --heartbeat-secs 30 \
    "$@"

echo
echo "fullstack-smoke: report at $OUT/report.md"
echo "fullstack-smoke: success criteria — 7/7 questions answered with hypotheses,"
echo "  valid citations, dirty queue drained (see report.json partial_conversations=0)."
