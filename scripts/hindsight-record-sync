#!/usr/bin/env bash
# Re-fetch the Hindsight LongMemEval-S record (the Agent Memory Benchmark
# run of upstream Hindsight) and regenerate
# crates/rustsight-eval/fixtures/hindsight_longmemeval_s.json, then diff the
# per-question verdicts against the committed fixture so a refreshed record
# shows exactly which questions flipped.
#
# Requires: curl, python3 (stdlib only). Network required.
#
# After a sync that shows flips: rerun `cargo test -p rustsight-eval` (the
# committed-record consistency test pins the headline numbers) and update
# NOTICE + README if the run's models changed.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FIXTURE="$ROOT/crates/rustsight-eval/fixtures/hindsight_longmemeval_s.json"
URL="https://raw.githubusercontent.com/vectorize-io/agent-memory-benchmark/main/outputs/longmemeval/hindsight/rag/s.json.gz"

fail() { echo "hindsight-record-sync: $*" >&2; exit 1; }

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

echo "hindsight-record-sync: fetching $URL"
curl -fsSL "$URL" -o "$WORK/s.json.gz" || fail "download failed (network? path moved?)"
gunzip -t "$WORK/s.json.gz" || fail "downloaded file is not the record (got the SPA shell?)"

python3 - "$WORK/s.json.gz" "$FIXTURE" "$(date +%F)" <<'PY'
import gzip, json, sys

src_path, fixture_path, fetched = sys.argv[1], sys.argv[2], sys.argv[3]

with gzip.open(src_path, "rt") as f:
    data = json.load(f)

KEEP = ["dataset", "split", "mode", "oracle", "memory_provider", "run_name",
        "total_queries", "correct", "accuracy", "answer_llm", "judge_llm",
        "ingested_docs", "avg_retrieve_time_ms", "avg_context_tokens"]
meta = {k: data[k] for k in KEEP if k in data}
meta.update({
    "fetched": fetched,
    "source_repo": "https://github.com/vectorize-io/agent-memory-benchmark",
    "source_path": "outputs/longmemeval/hindsight/rag/s.json.gz",
    "source_license": ("repository carries no license file; per-question verdicts "
                       "retained here for internal parity comparison only"),
    "note": ("per-question LongMemEval-S record for upstream Hindsight; ids match "
             "the HF longmemeval_s question_ids"),
})
results = [{
    "query_id": r["query_id"],
    "question_type": (r.get("category_axes") or {}).get("Question Type", [None])[0],
    "correct": bool(r["correct"]),
    "answer": r["answer"],
    "judge_reason": (r.get("judge_reason") or "")[:400],
} for r in sorted(data["results"], key=lambda r: r["query_id"])]

new = json.dumps({"meta": meta, "results": results}, indent=1) + "\n"

try:
    with open(fixture_path) as f:
        old = json.load(f)
    old_verdicts = {r["query_id"]: r["correct"] for r in old["results"]}
    new_verdicts = {r["query_id"]: r["correct"] for r in results}
    flips = sorted(q for q in new_verdicts
                   if q in old_verdicts and old_verdicts[q] != new_verdicts[q])
    added = sorted(set(new_verdicts) - set(old_verdicts))
    removed = sorted(set(old_verdicts) - set(new_verdicts))
    print(f"hindsight-record-sync: old {sum(old_verdicts.values())}/{len(old_verdicts)}"
          f" -> new {meta['correct']}/{meta['total_queries']}")
    if flips:
        print(f"verdict flips ({len(flips)}):")
        for q in flips:
            print(f"  {q}: {old_verdicts[q]} -> {new_verdicts[q]}")
    if added:
        print(f"new questions: {added}")
    if removed:
        print(f"removed questions: {removed}")
    if not (flips or added or removed):
        print("hindsight-record-sync: no per-question changes")
except FileNotFoundError:
    print("hindsight-record-sync: no previous fixture, creating it")

with open(fixture_path, "w") as f:
    f.write(new)
print(f"hindsight-record-sync: wrote {fixture_path}")
PY
